<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NoxSpeed" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/nox_black</item>
        <item name="android:statusBarColor">@color/nox_black</item>
        <item name="android:windowBackground">@color/nox_black</item>
    </style>
    <style name="Theme.NoxSpeed.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nox_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NoxSpeed</item>
    </style>
</resources>
